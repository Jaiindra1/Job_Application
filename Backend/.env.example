PORT=7000
MONGODB_URI=mongodb://127.0.0.1:27017/job_application
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_FRESHNESS_HOURS=6
ADZUNA_IMPORT_COOLDOWN_MS=30000
JOB_STALE_HOURS=48
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
JOOBLE_API_KEY=
PERSONAL_USER_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
